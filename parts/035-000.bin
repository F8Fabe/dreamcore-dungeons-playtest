/* Prefer portrait orientation without constraining the game viewport. */
(() => {
  'use strict';
  const mobile = navigator.userAgentData?.mobile === true ||
    /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) ||
    (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  if (!mobile) return;
  // Best effort only. Canvas sizing remains owned by Godot/the browser.
  async function lock() {
    try { await screen.orientation?.lock?.('portrait-primary'); } catch (_) {}
  }
  lock();
  window.addEventListener('pageshow', lock);
  document.addEventListener('fullscreenchange', lock);
  document.addEventListener('pointerup', lock, {once:true});
})();
