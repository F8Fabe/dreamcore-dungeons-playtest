/* One runtime per origin, acquired BEFORE IndexedDB is mounted. Never steal a
 * suspended tab's ownership: it may resume with an old in-memory filesystem. */
(() => {
 'use strict';
 let held=false, pending;
 const forever=new Promise(()=>{});
 window.dreamProfileOwner={
  get held(){return held;},
  acquire(){
   if(pending)return pending;
   pending=new Promise((resolve,reject)=>{
    if(!navigator.locks){reject(new Error('Safe save ownership is unavailable. Please use a supported browser.'));return;}
    navigator.locks.request('dreamcore-profile-writer-v1',{ifAvailable:true},lock=>{
     if(!lock){reject(new Error('Dreamcore Dungeons is already open. Close the other game window, then reload this page.'));return;}
     held=true;resolve();return forever;
    }).catch(reject);
   });
   return pending;
  }
 };
})();
