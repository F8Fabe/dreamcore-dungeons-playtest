/* Recover from a confirmed checkpoint automatically. A browser restore event is
 * not renderer recovery. Unknown persistence never authorizes an automatic reload. */
(() => {
  const guardKey='dream-context-auto-restart-v1', budget=15000, maxAttempts=2;
  let engine, save, lost=false, phase='idle', attempts=0, requestId=0, flushId=0;
  let checkpoint=false, durable=false, flight=false, remaining=0, last=performance.now();
  let visible=document.visibilityState==='visible', timer, reports=0, healthy=0;
  let panel,title,message,retry,restart,shownAfter=0;
  const mark=(code)=>window.dreamDiagnostics?.record({kind:'context_recovery',phase,code,attempt:attempts,visibility:document.visibilityState});
  function show(){
    if(panel)return;
    panel=document.createElement('section');panel.id='dream-context-recovery';
    panel.setAttribute('role','dialog');panel.setAttribute('aria-modal','true');panel.setAttribute('aria-label','Game recovery');
    panel.style.cssText='position:fixed;inset:0;z-index:2147483647;background:#211c30;color:#f9f1ff;padding:24px;display:flex;flex-direction:column;justify-content:center;gap:14px;font:18px system-ui;overflow:auto;box-sizing:border-box;opacity:0';
    panel.setAttribute('aria-hidden','true');
    title=document.createElement('h1');title.style.cssText='font-size:26px;margin:0';panel.append(title);
    message=document.createElement('p');message.setAttribute('role','status');panel.append(message);
    const button=(label,action)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.style.cssText='padding:16px;font:inherit;border:1px solid #b8a7ce;border-radius:10px;background:#382c4c;color:inherit';b.onclick=action;panel.append(b);return b;};
    retry=button('Try again',()=>{attempts=0;begin();});
    restart=button('Restart anyway',()=>reload(false));
    document.body.append(panel);
  }
  function progress(){show();title.textContent='Restoring your game…';message.textContent='Please wait a moment.';retry.hidden=true;restart.hidden=true;}
  function reveal(){panel.style.opacity='1';panel.removeAttribute('aria-hidden');}
  function storageBusy(){return engine?.rtenv?.dreamStorageState?.().syncing===true||(flight&&engine?.rtenv?.dreamStorageState?.().syncing!==false);}
  function decisionButtons(){
    const busy=storageBusy();retry.disabled=busy;restart.disabled=busy;
    message.textContent=busy?'Still saving. Please keep this page open.':durable?'Your progress is saved.':'Your latest progress may not be saved.';
  }
  function decision(code){
    phase='decision';mark(code);reveal();
    title.textContent=durable?'Ready to restart':'Please restart your game';
    retry.hidden=durable;restart.hidden=false;restart.textContent=durable?'Restart game':'Restart anyway';
    decisionButtons();
    if(!durable&&reports++<2)window.dreamObservatory?.failure('webgl_recovery_unconfirmed',code);
  }
  function problem(code){
    mark(code);
    if(attempts<maxAttempts){phase='retry';remaining=1000;progress();}
    else decision(code);
  }
  function reload(automatic){
    if(storageBusy())return;
    if(automatic){
      // This marker survives page reloads. Only a healthy visible interval below
      // rearms automatic restart, so repeated startup/loss cannot reload-loop.
      try{
        if(sessionStorage.getItem(guardKey)){decision('reload_guard');return;}
        sessionStorage.setItem(guardKey,'pending');
        if(sessionStorage.getItem(guardKey)!=='pending')throw new Error();
      }catch{decision('reload_guard_unavailable');return;}
    }
    phase='reloading';mark(automatic?'automatic_restart':'user_restart');
    clearInterval(timer);location.reload();
  }
  function begin(){
    if(!visible){phase='retry';remaining=0;return;}
    attempts++;remaining=budget;progress();
    if(checkpoint){sync();return;}
    phase='save';requestId++;mark(save?'save_requested':'bridge_missing');
    if(save)try{save(requestId);}catch{problem('bridge_exception');}
  }
  function sync(){
    phase='sync';remaining=budget;
    const runtime=engine?.rtenv;
    if(!runtime?.dreamSyncPersistent){problem('sync_bridge_missing');return;}
    // If a previous ACK was lost but the actual transaction ended, a NEW flush
    // is safe. If IDBFS is still active, await it rather than overlap transactions.
    if(flight&&runtime.dreamStorageState?.().syncing!==false){mark('sync_still_pending');return;}
    const token=++flushId;flight=true;mark('sync_requested');
    Promise.resolve().then(()=>runtime.dreamSyncPersistent()).then(()=>{
      if(token!==flushId)return;flight=false;durable=true;mark('sync_confirmed');
      phase='ready';tick();
    },error=>{
      if(token!==flushId)return;flight=false;
      const code=['storage_unavailable','storage_sync_failed'].includes(error?.message)?error.message:'sync_exception';
      if(phase==='decision'){mark(code);return;}problem(code);
    });
  }
  function tick(){
    const now=performance.now(),elapsed=Math.min(1000,Math.max(0,now-last));last=now;
    if(!visible||document.visibilityState!=='visible')return;
    shownAfter+=elapsed;if(shownAfter>=1000)reveal();
    if(phase==='decision'){decisionButtons();return;}
    if(phase==='ready'){reload(true);return;}
    if(!['save','sync','retry'].includes(phase))return;
    remaining-=elapsed;
    if(remaining>0)return;
    if(phase==='retry')begin();else problem(phase==='save'?'save_ack_timeout':'sync_ack_timeout');
  }
  let seasonFlight=null,seasonGeneration=0,seasonSaveStatus='';
  window.dreamContextRecovery={
    async flushStorage(fs){
      // Foreground deadlines belong to the state machine, not wall-clock timers
      // that expire while Android has suspended the game.
      while(fs._syncing)await new Promise(resolve=>setTimeout(resolve,25));
      if(!fs.is_persistent())throw new Error('storage_unavailable');
      const error=await fs.sync();if(error)throw new Error('storage_sync_failed');
    },
    get seasonSaveStatus(){return seasonSaveStatus;},
    beginSeasonSave(){
      const generation=++seasonGeneration;seasonSaveStatus='saving';
      // Retry joins a pending real transaction; if its ACK was lost but FS is idle,
      // issue a new flush. Old completions cannot acknowledge the newer attempt.
      if(!seasonFlight||engine?.rtenv?.dreamStorageState?.().syncing===false){
        const task=Promise.resolve().then(()=>window.dreamContextRecovery.persistProfile());
        seasonFlight=task;
        task.then(()=>{if(seasonFlight===task)seasonFlight=null;},()=>{if(seasonFlight===task)seasonFlight=null;});
      }
      seasonFlight.then(()=>{if(generation===seasonGeneration)seasonSaveStatus='saved';},()=>{if(generation===seasonGeneration)seasonSaveStatus='error';});
    },
    async persistProfile(){
      if(!engine?.rtenv?.dreamSyncPersistent)throw new Error("sync_bridge_missing");
      await engine.rtenv.dreamSyncPersistent();
    },
    attachEngine(value){engine=value;},
    install(callback){save=callback;if(callback&&phase==='save'&&visible)try{save(requestId);}catch{problem('bridge_exception');}},
    saved(id,ok){
      if(id!==requestId||!['save','retry'].includes(phase))return;
      if(!ok){problem('save_rejected');return;}
      checkpoint=true;mark('save_confirmed');sync();
    },
    get status(){return {phase,attempts,checkpoint,durable};}
  };
  document.addEventListener('visibilitychange',()=>{
    visible=document.visibilityState==='visible';last=performance.now();
    if(!lost)return;mark(visible?'visible':'hidden');
    if(visible)tick();
  });
  document.addEventListener('webglcontextlost',event=>{
    if(event.target!==document.getElementById('canvas'))return;
    event.preventDefault();if(lost)return;lost=true;
    const start=()=>{progress();mark('context_lost');last=performance.now();begin();timer=setInterval(tick,250);};
    if(document.body)start();else addEventListener('DOMContentLoaded',start,{once:true});
  },true);
  // Guard cleanup requires 30 seconds of visible initialized rendering, not a
  // wall-clock timeout (background suspension is excluded).
  let previous=performance.now();
  const healthTimer=setInterval(()=>{
    const now=performance.now(),elapsed=Math.min(500,Math.max(0,now-previous));previous=now;
    if(lost){clearInterval(healthTimer);return;}
    if(!save||document.visibilityState!=='visible')return;
    const gl=document.getElementById('canvas')?.getContext('webgl2');
    if(!gl||gl.isContextLost())return;
    healthy+=elapsed;
    if(healthy>=30000){try{sessionStorage.removeItem(guardKey);}catch{}clearInterval(healthTimer);}
  },250);
})();
