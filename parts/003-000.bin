{
  "releases": [
    {
      "build": "20261112T130846086183Z",
      "title": "Nightmare and public highscores",
      "summary": "Nightmare opens after a full Hard clear with that heroine. The hub now has public highscores for Nightmare, with a separate opt-in to share your future qualifying times.",
      "changes": [
        "Clear each Nightmare tier to unlock the next one for that heroine. Scores count active attempt time across the full run.",
        "Arena encounter compositions are seeded, and the run guide shows the Twins encounter.",
        "The arena progress strip shows encounter milestones. Boss rewards have a short reveal you can tap to skip.",
        "Browse Nightmare highscores by tier from the hub. Publishing future qualifying scores requires a separate opt-in, and adding a display name is optional."
      ]
    },
    {
      "build": "20261112T114957009657Z",
      "title": "Arena becomes the main game",
      "summary": "Normal and Hard are now the only regular run modes. This update starts everyone on a fresh profile and resets previous unlocks, gear, saved builds and active runs.",
      "changes": [
        "Start Normal or Hard from the hub. The original dungeon route and Champion Trials have been removed.",
        "Manage gear per heroine. Normal starts with a fresh skill build, and a winning build unlocks Hard for that heroine.",
        "Continue a saved Arena run from the hub. Gear carried into a run stays in the heroine’s collection if you replace it during the run.",
        "Opt-in playtest reports now track Arena difficulty, clears, build choices and gear progression."
      ]
    },
    {
      "build": "20261111T230417081421Z",
      "title": "Normal Dream, Hard and heroine progression",
      "summary": "Normal Dream is now the main arena route. Each heroine can keep her gear and a winning build, then take that build into Hard.",
      "changes": [
        "Play Normal Dream through 15 arenas. Save a winning Normal build to unlock Hard for that heroine. Hard starts with the saved skills and current gear and skips XP and skill drafts.",
        "Manage each heroine’s equipment in the Heroines menu. Compare, keep or replace her saved winning build after a Normal victory. The former dungeon run is in the Developer Tools archive.",
        "Chill stacks can trigger Freeze and Icebreak. Cascade can hit already frozen enemies without removing Freeze, and Frostfire Orb scales with both Fire and Frost Power.",
        "Normal shows banked levels and catches the XP display up during build breaks. After a camera drag, the view returns automatically after three seconds.",
        "Checkpoints from earlier rules require a fresh run. Hero unlocks and remaining pulls carry forward."
      ]
    },
    {
      "build": "20261111T162056835644Z",
      "title": "Dream V2 from the main hub",
      "summary": "The Dream Library now offers separate V1 and V2 tickets. V2 opens the full arena route with a heroine from your unlocked roster.",
      "changes": [
        "Choose Dream V1 for the original dungeon run or Dream V2 for the full arena route directly from the hub.",
        "Pick an unlocked heroine for a fresh V2 run, or continue from the V2 checkpoint.",
        "Return to the hub from V2 results or retry the same arena setup. V1 and V2 keep separate checkpoints.",
        "Checkpoints saved under earlier rules require a restart. Hero unlocks and remaining pulls stay available."
      ]
    },
    {
      "build": "20261111T154658824843Z",
      "title": "Full arena route and skill priority controls",
      "summary": "Pacing Prototype now has a six-arena Short run and a fifteen-arena Full run. Active skills show their priority and highlight where they will land when dragged.",
      "changes": [
        "Choose Full run in Developer Mode to fight through five dungeon tiers with a boss at the end of each tier.",
        "Arena enemies enter in formations from the right and approach the fight from their own lane. The hero starts on the left with a fixed arena camera.",
        "Drag active skills to change their casting priority. Numbered slots, a drag preview and a highlighted drop target show the new order.",
        "Fixed champion drag-and-drop setup in the Archive and made empty equipment slots non-interactive.",
        "Older run, trial and prototype checkpoints require a restart. Hero unlocks and remaining pulls stay available."
      ]
    },
    {
      "build": "20261111T144440333943Z",
      "title": "Arena mini-run and skill details",
      "summary": "Pacing Prototype now takes place in six arenas with a centred camera. Reward cards now link to the full skill details.",
      "changes": [
        "Fight six authored encounters with flanking waves, ranged pressure and a commander who buffs surviving enemies.",
        "Build breaks after arenas 1, 3 and 5 advance you to levels 3, 6 and 9 and restore HP and mana.",
        "Arena progress uses a separate save and resumes from the start of the current arena. Earlier runs, trials and prototypes require a restart. Hero unlocks and remaining pulls stay available.",
        "Open full skill details from a reward card to see effective values and learned modifiers.",
        "Combat sound, reduced Poolrooms effects and extra fire particle settings now persist after restarting the game."
      ]
    },
    {
      "build": "20261111T135650440061Z",
      "title": "Crossbows, ranged combat and Pacing Prototype v2",
      "summary": "Crossbows join the ranged weapon pool, and combat targeting now uses range and valid targets without wall sight checks. Pacing Prototype v2 starts at level 1 and tests three combat sections with two build breaks.",
      "changes": [
        "Added a slow physical crossbow family with bow range. Heavy Shot now hits a selected target, and Prism Lens adds a bounce that grows stronger along its path.",
        "Ranged projectiles no longer pierce through enemies. Walls no longer block valid attacks, area effects or bounces within range. Walls still constrain movement.",
        "Pacing Prototype v2 uses real class starter choices, three combat sections and two build breaks. The commander buffs surviving enemies until he falls.",
        "Ability reward cards now flip to reveal the skill before you choose it.",
        "Runs and trials saved under earlier rules require a restart. Hero unlocks and remaining pulls stay available."
      ]
    },
    {
      "build": "20261110T003918660734Z",
      "title": "Pacing Prototype",
      "summary": "Developer Mode now includes a short, separately saved Pacing Prototype. It tests two combat sections, a build break and a Poolcaller fight.",
      "changes": [
        "Open Pacing Prototype in Developer Mode and choose an On-Hit, Poison or Fire preset and a seed.",
        "Face overlapping enemy groups with warnings before reinforcements. Between sections, choose a passive, decide whether to take an active skill, and resolve an item before continuing.",
        "Resume at the start of the current section from a separate prototype save. Prototype runs leave normal progression alone, and the results screen can copy a test report.",
        "Runs and trials saved under earlier rules require a restart. Hero unlocks and remaining pulls stay available."
      ]
    },
    {
      "build": "20261109T234912424512Z",
      "title": "Hero unlocks and Champion Trial results",
      "summary": "Hero unlocks and remaining pulls survive restarting after an incompatible saved run or trial. This build also includes the Champion Trial results fix.",
      "changes": [
        "Preserved unlocked heroines and remaining pulls when restarting after an incompatible saved run or trial. The original save stays backed up.",
        "Fixed recursive results navigation when a timed Champion Trial ends."
      ]
    },
    {
      "build": "20261109T230844938167Z",
      "title": "Cached startup, combat readability and playtest privacy",
      "summary": "The start screen now offers Play when the current build is cached. This update also improves combat readability, simplifies peaceful encounters and updates voluntary playtest sharing.",
      "changes": [
        "Play appears when both game files are cached; the download prompt estimates only the files still needed.",
        "Added compact skill details, hold-to-inspect controls and clearer combat numbers on phones. Level-up effects now appear on the reward cards.",
        "Peaceful encounters use shorter approach and exit paths; active skills are disabled outside combat. Navigation skips detailed searches between disconnected areas.",
        "Fixed a crash when opening the result after a timed Champion Trial.",
        "Playtest sharing requires a fresh opt-in with 18+ confirmation. Withdrawing consent stops uploads and requests deletion of shared data, with retry when back online."
      ]
    },
    {
      "build": "20261106T144243658746Z",
      "title": "Solo runs, Blacksmith and combat performance",
      "summary": "Normal runs are now solo, with a Blacksmith visit at the start of Dungeon 4. This update also changes crafting access, reduces repeated combat work and refreshes menu and dungeon visuals.",
      "changes": [
        "Reduced repeated combat work with shared actor lookups, budgeted path searches and cached runtime stats.",
        "Removed mercenary recruitment from normal runs. The Blacksmith at the start of Dungeon 4 lets you choose one equipped item, craft it with your materials, then finish or skip the visit.",
        "Craft unresolved drops before equipping them. Accepted and merchant gear stays sealed outside the Blacksmith session; replacement comparisons no longer reveal randomized salvage materials.",
        "Character, damage and settings popups now share glass panels, compact value tables and sizing based on their contents. Removed the duplicate portrait from the settings popup.",
        "Added themed entrances and open/closed exits for the poolrooms, suburb, mall and windmill dungeons."
      ]
    },
    {
      "build": "20261106T133633251631Z",
      "title": "Download prompt and rendering fixes",
      "summary": "The loading screen now asks before downloading the game and shows its size and progress in MB. Small effect and reward polygons also render more reliably.",
      "changes": [
        "Added a download confirmation with the game-file size, Download & play and Not now. The large engine and game files start downloading only after confirmation; loading progress shows loaded and total MB.",
        "Postponing the download or closing during loading remains a session diagnostic rather than a bug report. Genuine download, startup, JavaScript and engine errors remain reportable.",
        "Fixed polygon triangulation errors in shrinking combat fragments and shared ticket/reward surfaces while preserving their visible shapes."
      ]
    },
    {
      "build": "20261105T140652191084Z",
      "title": "Playtest upload improvements",
      "summary": "Playtest uploads now respect service retry times and keep daily-limit pauses after reloading. Recording and uploads read less local history.",
      "changes": [
        "Playtest uploads honor server retry delays. Daily-limit pauses persist across page reloads and reconnects while pending records remain queued within the existing storage limit.",
        "Reduced local history reads during playtest recording and uploads. Existing acknowledged history remains available for local export."
      ]
    },
    {
      "build": "20261104T214321945322Z",
      "title": "Equipment and loot rework",
      "summary": "Loot now equips directly or becomes crafting materials. Replacing equipment automatically salvages the previous item, and equipped gear can be crafted between fights.",
      "changes": [
        "Removed the backpack and backup item slots. Only equipped gear is retained; each pending loot item must be equipped or salvaged before continuing.",
        "Equipping loot or accepting the free merchant item replaces the same-slot item and salvages it once. Comparisons show the replacement material and skills incompatible with the new weapon.",
        "Replaced inventory swapping with a four-slot equipment screen. Crafting works on equipped hero gear outside combat and on pending loot; companion equipment remains fixed."
      ]
    },
    {
      "build": "20261104T151107051426Z",
      "title": "Combat and build rework",
      "summary": "Reworked weapon combat, class starts and build upgrades, with weapon drops that better reflect your build. Navigation now does less repeated work in crowded fights.",
      "changes": [
        "Added class-specific starter choices with a core skill and matching weapon. Weapon enhancers now combine on the original autoattack in configured order, with shared action-level mana budgets.",
        "Raised Heavy Strike to 1,000% attack and added Focused Discharge (+60% direct Lightning Strike damage). Reverberation offers now consider effective lightning sources, including Storm Cabinet, while remaining available without one.",
        "Weapon drops and merchants now roll a weapon family before a specific weapon. Matching skills provide the main weighting bonus, capped at 2x; other weapon families remain available.",
        "Skill maps now distinguish prerequisites, upgrades, synergies, alternatives and exclusions. Added 24 build-direction presets; compatible upgrades can be combined instead of treated as exclusive forms.",
        "Reduced repeated collision and pathfinding work in crowded fights. Blocked actors wait briefly before retrying instead of continuously searching for another attack position. Added a persistent 60/120 FPS setting, with 120 FPS as the default."
      ]
    },
    {
      "build": "20261104T130359766724Z",
      "title": "Dream Ticket fix :3",
      "summary": "Fixed a Dream Ticket rendering error. This update also simplifies playtest consent and reduces upload data.",
      "changes": [
        "Fixed a polygon triangulation error in the Dream Ticket shimmer when returning from the hero gallery to the start screen.",
        "Replaced the initial playtest consent screen with a compact dialog and expandable data details.",
        "Reduced playtest upload size with compressed batches and smaller build snapshots."
      ]
    }
  ]
}