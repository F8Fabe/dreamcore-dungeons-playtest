  "notes": {
    "title": "Boss tuning and active-first rewards",
    "summary": "Arena bosses now use profiles for the dungeon tier where you fight them. When a level break offers several skill picks, active choices come first.",
    "changes": [
      "Boss and reinforcement health and damage use tier-specific values across Dungeons 1\u20135.",
      "Boss fights have finite healing, shield and summon budgets that persist when you resume an arena.",
      "Boss enemies use a dedicated 3\u00d7 attack coefficient for Heavy Strike.",
      "Resolve all earned active skill offers before passive offers. Passive rolls then use the build you just chose."
    ]
  }
