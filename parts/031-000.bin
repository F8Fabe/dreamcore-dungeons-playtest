  "notes": {
    "title": "Smoother dungeon scaling and clearer combat HUD",
    "summary": "Enemy stats now scale more evenly from Dungeon 1 through 5. Combat warnings and HUD labels are easier to read, and the guide portrait appears while she speaks.",
    "changes": [
      "Enemy health and damage now scale by consistent steps between dungeon tiers, including bosses and their reinforcements.",
      "Adjusted damage bursts and warning times on selected enemy attacks.",
      "Added shadows to arena labels and route markers, and removed the backgrounds behind damage icons.",
      "The guide portrait fades out after dialogue, and arena route labels stay within the screen edges."
    ]
  }
