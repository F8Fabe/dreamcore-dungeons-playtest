/* Bounded local-only breadcrumbs. No telemetry, network calls or save manipulation. */
(() => {
  let savedExperiment = 'baseline';
  try { savedExperiment = localStorage.getItem('dreamcore-render-experiment') || 'baseline'; } catch (_) {}
  const requested = new URLSearchParams(location.search).get('render-test') || savedExperiment;
  const experiment = ['no-audio', 'no-blur', 'dpr2'].includes(requested) ? requested : 'baseline';
  window.dreamRenderExperiment = experiment;
  const nativePixelRatio = typeof devicePixelRatio === 'number' ? devicePixelRatio : 1;
  let effectivePixelRatio = nativePixelRatio;
  if (experiment === 'dpr2') {
    try {
      Object.defineProperty(window, 'devicePixelRatio', {configurable: true, get: () => Math.min(nativePixelRatio, 2)});
      effectivePixelRatio = window.devicePixelRatio;
    } catch (_) {} // Report the actual result rather than pretending the cap worked.
  }
  const key = 'dreamcore-render-diagnostics-v1';
  let previous = null;
  try {
    const last = JSON.parse(localStorage.getItem(key));
    const useful = last?.engine || last?.samples?.length || last?.events?.some(e => !['start', 'visibility'].includes(e.kind));
    if (useful) localStorage.setItem(key + '-previous', JSON.stringify(last));
    previous = useful ? last : JSON.parse(localStorage.getItem(key + '-previous'));
  } catch (_) {}
  const session = {experiment, nativePixelRatio, effectivePixelRatio, build: document.documentElement.dataset.build || 'local', started: Date.now(), events: [], resources: [], failures: [], samples: [], engine: null};
  let lastWrite = 0;
  function persist(immediate = false) {
    if (!immediate && Date.now() - lastWrite < 1000) return;
    lastWrite = Date.now();
    try { localStorage.setItem(key, JSON.stringify(session)); } catch (_) {}
  }
  function record(value, immediate = false) {
    const entry = {at: Date.now(), ...value};
    // Large ownership snapshots have their own small ring. An action no longer
    // serializes sixty full snapshots, nor do samples displace critical events.
    if (entry.resource) {
      session.resources.push(entry); session.resources = session.resources.slice(-32);
    } else if (entry.render) {
      session.samples.push(entry); session.samples = session.samples.slice(-6);
    } else {
      session.events.push(entry); session.events = session.events.slice(-100);
    }
    persist(immediate);
  }
  function heartbeat(value) {
    const canvas = document.getElementById('canvas');
    session.engine = {at: Date.now(), ...value,
      canvas: canvas ? {width: canvas.width, height: canvas.height} : null,
      visibility: document.visibilityState};
    persist();
  }
  function report() {
    return JSON.stringify({schema: 4, previous, current: session, device: {
      userAgent: navigator.userAgent, width: innerWidth, height: innerHeight,
      pixelRatio: devicePixelRatio, standalone: !!navigator.standalone
    }}, null, 2);
  }
  function open() {
    document.getElementById('dream-diagnostics-panel')?.remove();
    const panel = document.createElement('section'); panel.id = 'dream-diagnostics-panel';
    panel.style.cssText = 'position:fixed;inset:0;z-index:100001;background:#211c30;color:#f9f1ff;padding:max(18px,env(safe-area-inset-top)) 18px max(18px,env(safe-area-inset-bottom));font:16px system-ui;display:flex;flex-direction:column;gap:12px;box-sizing:border-box;overflow:auto';
    const title = document.createElement('strong'); title.textContent = 'Dreamcore Diagnostics'; panel.appendChild(title);
    const note = document.createElement('div'); note.textContent = 'Local report, including the previous session when available. Share this after a reload/crash. No upload happens automatically.'; panel.appendChild(note);
    const selector = document.createElement('select');
    for (const [value, label] of [['baseline','Normal'],['no-audio','Test: Audio vollständig aus'],['no-blur','Test: Glas ohne Blur'],['dpr2','Test: Pixeldichte maximal 2']]) {
      const option = document.createElement('option'); option.value = value; option.textContent = label;
      selector.appendChild(option);
    }
    selector.value = experiment; selector.setAttribute('aria-label', 'Vergleichstest'); panel.appendChild(selector);
    button('Gewählten Test speichern und neu starten', () => {
      try { localStorage.setItem('dreamcore-render-experiment', selector.value); } catch (_) {}
      const target = new URL(location.href); target.searchParams.set('render-test', selector.value);
      location.href = target.href;
    });
    const restartNote = document.createElement('div');
    restartNote.textContent = 'Neustart lädt den letzten Spielstand. Bitte jeweils nur einen Test vergleichen; Normal setzt die Teständerungen zurück.';
    panel.appendChild(restartNote);
    const field = document.createElement('textarea'); field.readOnly = true; field.value = report();
    field.style.cssText = 'min-height:140px;flex:1;font:12px monospace;background:#130f20;color:#eee;border:1px solid #a38bc4'; panel.appendChild(field);
    const status = document.createElement('div'); panel.appendChild(status);
    function button(label, action) {
      const b = document.createElement('button'); b.textContent = label;
      b.style.cssText = 'padding:12px;background:#baa3df;color:#211c30;border:0;border-radius:10px;font:inherit;flex-shrink:0';
      b.onclick = action; panel.appendChild(b);
    }
    button('Share report', async () => {
      try {
        const file = new File([field.value], 'dreamcore-diagnostics.json', {type: 'application/json'});
        if (navigator.canShare?.({files: [file]})) await navigator.share({files: [file], title: 'Dreamcore Diagnostics'});
        else if (navigator.share) await navigator.share({text: field.value, title: 'Dreamcore Diagnostics'});
        else status.textContent = 'Sharing unavailable here. Copy or save the report below.';
      } catch (e) { status.textContent = e.name === 'AbortError' ? 'Sharing cancelled.' : 'Sharing failed. Copy or save the report instead.'; }
    });
    button('Copy report', async () => {
      try { await navigator.clipboard.writeText(field.value); status.textContent = 'Copied!'; }
      catch (_) { field.focus(); field.select(); status.textContent = 'Select the report text and copy it manually.'; }
    });
    button('Save JSON file', () => window.dreamDiagnostics.download());
    button('Back to game', () => panel.remove());
    document.body.appendChild(panel);
  }
  window.dreamDiagnostics = {record, heartbeat, failure, previous, current: session, open, download() {
    const blob = new Blob([report()], {type: 'application/json'});
    const url = URL.createObjectURL(blob); const link = document.createElement('a');
    link.href = url; link.download = 'dreamcore-diagnostics.json'; link.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }};
  // Persist the first failure of each type even directly after a normal mark.
  // Previously the one-second throttle could lose the only clue before a reload.
  const failures = new Set();
  function failure(kind, message = '') {
    const first = !failures.has(kind); failures.add(kind);
    if (first) session.failures.push({at: Date.now(), kind, message: String(message).slice(0, 500)});
    record({kind, message: String(message).slice(0, 500)}, first);
  }
  addEventListener('error', e => failure('error', e.message));
  addEventListener('unhandledrejection', e => failure('rejection', e.reason));
  document.addEventListener('webglcontextlost', e => failure('webglcontextlost', e.statusMessage), true);
  document.addEventListener('visibilitychange', () => record({kind: 'visibility', state: document.visibilityState}, true));
  addEventListener('pagehide', e => record({kind: 'pagehide', persisted: !!e.persisted}, true));
  document.addEventListener('webglcontextrestored', () => record({kind: 'webglcontextrestored'}, true), true);
  record({kind: 'start'});
  // Explicit opt-in link for a mobile report, without opening browser developer tools.
  if (new URLSearchParams(location.search).has('diagnostics')) {
    addEventListener('DOMContentLoaded', () => {
      const button = document.createElement('button'); button.textContent = 'Diagnose speichern';
      button.style.cssText = 'position:fixed;right:8px;top:8px;z-index:10000';
      button.onclick = () => window.dreamDiagnostics.open(); document.body.appendChild(button);
    });
  }
})();
