/* A latched, user-controlled restart after context loss. No consent/telemetry
 * dependency, no automatic reload, no promise of seamless renderer recovery. */
(() => {
  let engine, save, lost=false, serial=0, pending=0, timer, flushing=false;
  let panel, message, retry, restart, abandon, confirm;
  function show() {
    if (panel) return;
    panel=document.createElement('section'); panel.id='dream-context-recovery';
    panel.setAttribute('role','dialog');panel.setAttribute('aria-modal','true');
    panel.setAttribute('aria-label','Graphics interrupted');
    panel.style.cssText='position:fixed;inset:0;z-index:2147483647;background:#211c30;color:#f9f1ff;padding:24px;display:flex;flex-direction:column;justify-content:center;gap:16px;font:18px system-ui;overflow:auto;box-sizing:border-box';
    const title=document.createElement('h1');title.textContent='Graphics interrupted';panel.append(title);
    message=document.createElement('p');message.setAttribute('role','status');panel.append(message);
    const button=(label,action)=>{const b=document.createElement('button');b.type='button';b.textContent=label;b.style.cssText='padding:16px;font:inherit';b.onclick=action;panel.append(b);return b;};
    retry=button('Try saving again',request);
    restart=button('Restart game',reload);
    abandon=button('Restart without confirmed save',()=>{
      confirm.hidden=false;abandon.hidden=true;
      message.textContent='The latest save could not be confirmed. Restarting may lose recent progress. You can keep this page open and try saving again.';
    });
    confirm=button('Restart anyway — recent progress may be lost',reload);
    document.body.append(panel);
  }
  function reload() {
    window.dreamDiagnostics?.record({kind:'restart_requested',reason:'context_loss'});
    location.reload();
  }
  function failed() {
    clearTimeout(timer);pending=0;
    message.textContent='We could not confirm that your latest checkpoint reached browser storage. Keep this page open and try saving again, or explicitly restart with possible loss of recent progress.';
    retry.hidden=false;restart.hidden=true;abandon.hidden=false;confirm.hidden=true;
  }
  function dispatch(){if(pending&&save)try{save(pending);}catch{failed();}}
  function request() {
    if(flushing){message.textContent='Browser storage is still responding. Please wait before trying again.';return;}
    show();clearTimeout(timer);pending=++serial;
    message.textContent='Saving your checkpoint before restart…';
    retry.hidden=true;restart.hidden=true;abandon.hidden=true;confirm.hidden=true;
    timer=setTimeout(failed,15000);dispatch();
  }
  window.dreamContextRecovery={
    // Called from the version-checked loader closure. GodotFS.sync resolves
    // with an error rather than rejecting; require a fresh acknowledged flush.
    async flushStorage(fs){
      const deadline=Date.now()+10000;
      while(fs._syncing){
        if(Date.now()>=deadline)throw new Error('storage_busy');
        await new Promise(resolve=>setTimeout(resolve,25));
      }
      if(!fs.is_persistent())throw new Error('storage_unavailable');
      const error=await fs.sync();
      if(error)throw new Error('storage_sync_failed');
    },
    attachEngine(value){engine=value;},
    install(callback){save=callback;if(callback)dispatch();},
    async saved(id,ok){
      if(!pending||id!==pending)return;
      if(!ok){failed();return;}
      flushing=true;
      try{
        if(!engine?.rtenv?.dreamSyncPersistent)throw new Error('unavailable');
        await engine.rtenv.dreamSyncPersistent();
        if(id!==pending)return;
        clearTimeout(timer);pending=0;
        message.textContent='Checkpoint saved in this browser. Restart to restore graphics. An active arena resumes from its saved checkpoint, not the exact interrupted combat moment.';
        restart.hidden=false;retry.hidden=true;abandon.hidden=true;confirm.hidden=true;
        restart.focus();
      }catch{if(id===pending)failed();}
      finally{flushing=false;}
    }
  };
  document.addEventListener('webglcontextlost',event=>{
    if(event.target!==document.getElementById('canvas'))return;
    event.preventDefault();
    if(lost)return;lost=true;
    if(document.body)request();else addEventListener('DOMContentLoaded',request,{once:true});
  },true);
})();
